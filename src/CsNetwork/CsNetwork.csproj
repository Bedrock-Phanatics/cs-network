<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CsNetwork</AssemblyName>
    <RootNamespace>CsNetwork</RootNamespace>
    <PackageId>CsNetwork</PackageId>
    <Description>Ultra-high-performance, zero-allocation, secure Minecraft: Bedrock Edition networking library for .NET 10.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>
</Project>
